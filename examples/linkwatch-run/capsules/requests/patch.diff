+# Generated by Gemma via DepExit: AI-written characterisation tests.
+def test_user_agent_preserved(server):
+    from linkwatch.checker import fetch
+    resp = fetch(f"{server}/echo-ua")
+    assert resp.text == "linkwatch/1.0"
+
+def test_encoding_detection_preserved(server):
+    from linkwatch.checker import fetch
+    from linkwatch.encoding import detect_encoding
+    
+    # Test explicit charset
+    resp_utf8 = fetch(f"{server}/ok")
+    assert detect_encoding(resp_utf8) == "utf-8"
+    
+    # Test fallback to chardet (no charset in header)
+    resp_latin1 = fetch(f"{server}/latin1")
+    assert detect_encoding(resp_latin1) is not None
