+# Generated by Gemma via DepExit: AI-written characterisation tests.
+import pytest
+from pydantic import ValidationError
+from linkwatch.config import Site, Settings
+
+def test_site_validation():
+    # Test empty name
+    with pytest.raises(ValidationError, match="site name can not be empty"):
+        Site(name="", url="http://example.com")
+    
+    # Test invalid url
+    with pytest.raises(ValidationError, match="url must start with http:// or https://"):
+        Site(name="Example", url="example.com")
+    
+    # Test valid site and whitespace stripping
+    site = Site(name=" Example ", url="https://example.com")
+    assert site.name == "Example"
+
+def test_settings_validation():
+    # Test extra forbid
+    with pytest.raises(ValidationError):
+        Settings(title="test", extra_field="not allowed")
+    
+    # Test valid settings
+    settings = Settings(title="test", sites=[Site(name="S", url="http://s.com")])
+    assert settings.title == "test"
